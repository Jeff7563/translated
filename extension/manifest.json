{
  "manifest_version": 3,
  "name": "TranslateT – แปลเว็บให้เป็นธรรมชาติ",
  "short_name": "TranslateT",
  "version": "0.1.0",
  "description": "แปลหน้าเว็บและบอลลูนการ์ตูนด้วย AI ให้อ่านลื่นเหมือนคนเขียนเอง ทุกคู่ภาษา",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "TranslateT" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+T" },
      "description": "แปล / คืนต้นฉบับ หน้านี้"
    }
  }
}
